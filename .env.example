# BagBill Production Environment Configuration Example
# Copy this file to create your local or deployment environment variables

# Frontend Configuration (.env)
# Set this in your Vercel deployment if backend is hosted separately on Render:
# VITE_API_URL=https://bagbill-api.onrender.com

# Backend Server Configuration (backend/.env)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bagbill?retryWrites=true&w=majority
CLIENT_URL=https://bag-bill-iota.vercel.app
NODE_ENV=production
